{
    "name": "edulazaro/toxicfilter-sdk",
    "description": "The official PHP client for the ToxicFilter content moderation API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Edu Lazaro",
            "homepage": "https://edulazaro.com"
        }
    ],
    "keywords": [
        "moderation",
        "content-moderation",
        "toxicity",
        "spam",
        "api",
        "client",
        "toxicfilter"
    ],
    "homepage": "https://toxicfilter.com/docs/sdks/php",
    "support": {
        "issues": "https://github.com/toxicfilter/php-sdk/issues",
        "source": "https://github.com/toxicfilter/php-sdk",
        "docs": "https://toxicfilter.com/docs/sdks/php"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "ToxicFilter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ToxicFilter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
